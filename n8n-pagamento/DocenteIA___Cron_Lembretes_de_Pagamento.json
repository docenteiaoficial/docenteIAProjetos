    {
      "parameters": {
        "jsCode": "// Filtra atrasados com mais de 3 dias de atraso → bloquear\n// Filtra atrasados com menos de 3 dias → lembrete\nconst professores = $input.all();\nconst agora = new Date();\nconst resultado = [];\n\nfor (const item of professores) {\n  const prof = item.json;\n  if (!prof.telefone) continue;\n\n  const dataVenc = prof.data_vencimento ? new Date(prof.data_vencimento) : null;\n  const diasAtraso = dataVenc ? Math.floor((agora - dataVenc) / (1000 * 60 * 60 * 24)) : 0;\n\n  resultado.push({\n    id: prof.id,\n    nome: prof.nome || 'Professor(a)',\n    telefone: prof.telefone,\n    instancia: prof.instancia || 'docenteia',\n    email: prof.email || '',\n    dias_atraso: diasAtraso,\n    deve_bloquear: diasAtraso > 3,\n    deve_lembrar: diasAtraso <= 3,\n    data_vencimento: prof.data_vencimento\n  });\n}\n\nreturn resultado;"
      },
      "id": "08e36bfc-1be3-452f-b8b8-a91e25f718dd",
      "name": "⚙️ Classificar Atrasados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
        48
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filtra trials que vencem amanhã\nconst professores = $input.all();\nconst agora = new Date();\nconst amanha = new Date(agora.getTime() + 24 * 60 * 60 * 1000);\nconst resultado = [];\n\nfor (const item of professores) {\n  const prof = item.json;\n  if (!prof.telefone) continue;\n\n  const trialExpira = prof.trial_expira_em ? new Date(prof.trial_expira_em) : null;\n  if (!trialExpira) continue;\n\n  const diffDias = Math.floor((trialExpira - agora) / (1000 * 60 * 60 * 24));\n\n  // Avisa quando faltam 1 ou 2 dias\n  if (diffDias >= 0 && diffDias <= 2) {\n    resultado.push({\n      id: prof.id,\n      nome: prof.nome || 'Professor(a)',\n      telefone: prof.telefone,\n      instancia: prof.instancia || 'docenteia',\n      dias_restantes: diffDias,\n      trial_expira_em: prof.trial_expira_em\n    });\n  }\n\n  // Expirou → bloquear\n  if (diffDias < 0) {\n    resultado.push({\n      id: prof.id,\n      nome: prof.nome || 'Professor(a)',\n      telefone: prof.telefone,\n      instancia: prof.instancia || 'docenteia',\n      dias_restantes: diffDias,\n      trial_expira_em: prof.trial_expira_em,\n      deve_bloquear: true\n    });\n  }\n}\n\nreturn resultado;"
      },
