      "id": "5f65e90b-0f2c-4aa9-82d5-db6f2c5247e7",
      "name": "📂 Listar Arquivos da Pasta",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -656,
        -176
      ],
      "alwaysOutputData": false,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "KEagKKMnotHtHqUf",
          "name": "Google Drive account"
        }
      },
      "notes": "Lista todos os arquivos na pasta PLANOS_GERADOS. Substituir SUBSTITUIR_ID_PASTA_PLANOS_GERADOS pelo ID real."
    },
    {
      "parameters": {
        "jsCode": "const agora = Date.now();\nconst LIMITE_MS = 24 * 60 * 60 * 1000;\n\n// Tenta pegar de $json.files (HTTP Request) ou $input.all() (nó nativo)\nlet arquivos = [];\n\ntry {\n  const files = $input.first().json?.files;\n  if (Array.isArray(files) && files.length > 0) {\n    arquivos = files;\n  } else {\n    arquivos = $input.all().map(i => i.json);\n  }\n} catch(e) {\n  arquivos = $input.all().map(i => i.json);\n}\n\n// Se não tem createdTime, exclui mesmo (arquivo sem data = seguro deletar)\nconst paraExcluir = arquivos.filter(f => {\n  if (!f.createdTime) return true;\n  const criado = new Date(f.createdTime).getTime();\n  return (agora - criado) > LIMITE_MS;\n});\n\nif (paraExcluir.length === 0) {\n  return [{ json: { nada_para_excluir: true, total: 0 } }];\n}\n\nreturn paraExcluir.map(f => ({\n  json: {\n    nada_para_excluir: false,\n    file_id: f.id,\n    file_name: f.name,\n    criado_em: f.createdTime || 'sem data'\n  }\n}));"
      },
      "id": "a980b82c-a8c7-4f48-9351-111fb6174399",
      "name": "🔍 Filtrar Arquivos Antigos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
