    {
      "parameters": {
        "jsCode": "const formData = $input.item.json;\nconst params = formData.formQueryParameters || {};\n\n// 1. Pega WhatsApp DIRETO DA URL (O professor não digita, vem do link do Bot)\nlet whatsRaw = params.whatsapp || '';\n\n// Garante que o JID esteja completo para o Supabase e Evolution API\nlet remoteJid = whatsRaw;\nif (whatsRaw && !whatsRaw.includes('@s.whatsapp.net')) {\n  let whatsClean = String(whatsRaw).replace(/\\D/g, '');\n  remoteJid = `${whatsClean}@s.whatsapp.net`;\n}\n\nlet instancia = params.instancia || 'whtas';\n\n// 2. Pega resto dos dados do formulário\nlet nome = formData.Nome || '';\nlet email = formData['E-mail'] || '';\nlet escola = formData['Nome da escola que trabalha'] || '';\nlet diretoria = formData['Diretoria a que pertence'] || '';\n\n// Calcula trial (3 dias)\nlet trialDate = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\n\nreturn {\n  json: {\n    nome,\n    email,\n    telefone: remoteJid, // Salva o JID completo no banco, igual ao Orquestrador\n    remoteJid,\n    escola,\n    diretoria,\n    instancia,\n    trial_expira_em: trialDate\n  }\n};"
      },
