      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst instance = (input.instance || '').trim();\nconst remoteJid = (input.remoteJid || '').trim();\n\nif (!instance || !remoteJid) {\n  throw new Error(`Parâmetros insuficientes — instance: '${instance}', remoteJid: '${remoteJid}'`);\n}\n\nreturn [{ json: { instance, remoteJid } }];"
      },
      "id": "ef407f12-10dd-45fe-b965-fd7d7036870b",
      "name": "✅ Validar Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "professores",
        "filters": {
          "conditions": [
            {
              "keyName": "telefone",
              "condition": "eq",
              "keyValue": "={{ $json.remoteJid }}"
            }
          ]
        }
      },
      "id": "b24c5a27-341b-4c7e-ad37-f4d5b96bcd8b",
      "name": "🔍 Buscar Professor Supabase",
