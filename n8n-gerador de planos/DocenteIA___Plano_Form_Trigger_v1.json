        "supabaseApi": {
          "id": "0rCAcHMiMIvLQHTk",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "resource": "messages-api",
        "instanceName": "={{ ($item(\"0\").$node[\"🔍 Buscar Professor Supabase\"].json[\"instancia\"] || $('✅ Validar Inputs').item.json.instance) }}",
        "remoteJid": "={{ ($item(\"0\").$node[\"🔍 Buscar Professor Supabase\"].json[\"telefone\"] || $('✅ Validar Inputs').item.json.remoteJid) }}",
        "messageText": "=📋 *Gerador de Plano de Aula*\n\nOlá, {{ $item(\"0\").$node[\"🔍 Buscar Professor Supabase\"].json[\"nome\"] || 'Professor(a)' }}! 👋\n\nPara criar seu plano semanal (segunda a sexta), acesse o formulário abaixo e informe:\n• Série\n• Disciplina\n• Tema\n• Descrição da aula (opcional — contexto extra para a IA)\nhttps://n8n.docenteia.com.br/form/d90ff736-8ea1-4ab2-8e6e-cae3aa6ea155?instancia={{ encodeURIComponent($json.instancia || $('✅ Validar Inputs').item.json.instance) }}&whatsapp={{ encodeURIComponent($json.telefone || $('✅ Validar Inputs').item.json.remoteJid) }}\n\n⏱️ Leva menos de 1 minuto. Assim que enviar, gero seu plano completo com habilidades BNCC e envio aqui! 📄",
        "options_message": {
          "delay": 500
        }
      },
      "id": "b719d97e-b4f5-4aa8-8ca0-a0bda9f8a296",
      "name": "📨 Enviar Link WhatsApp",
