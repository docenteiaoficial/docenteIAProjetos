      "name": "✅ Validar Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "professores",
        "filters": {
          "conditions": [
            {
              "keyName": "telefone",
              "condition": "eq",
              "keyValue": "={{ $json.remoteJid }}"
            }
          ]
        }
      },
      "id": "aeb8340a-9610-4c05-9bdd-ddc1e63540bb",
