    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst instance = (input.instance || '').trim();\nconst remoteJid = (input.remoteJid || '').trim();\n\nif (!instance || !remoteJid) {\n  throw new Error('Parâmetros insuficientes — instance: ' + instance + ', remoteJid: ' + remoteJid);\n}\n\nreturn [{ json: { instance, remoteJid } }];"
      },
